{
  "name": "@imxade/inject",
  "version": "0.1.1",
  "description": "Low-level cross-platform native input injection primitives for Node.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./linux": {
      "types": "./dist/linux/index.d.ts",
      "import": "./dist/linux/index.js"
    },
    "./mac": {
      "types": "./dist/mac/index.d.ts",
      "import": "./dist/mac/index.js"
    },
    "./windows": {
      "types": "./dist/windows/index.d.ts",
      "import": "./dist/windows/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "biome check src test vitest.config.ts",
    "check:fix": "biome check --write src test vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check && npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run",
    "test:e2e:linux": "vitest run test/native/linux.e2e.test.ts",
    "test:e2e:macos": "vitest run test/native/macos.e2e.test.ts",
    "test:e2e:windows": "vitest run test/native/windows.e2e.test.ts"
  },
  "keywords": [
    "input",
    "native",
    "uinput",
    "coregraphics",
    "sendinput",
    "vigem",
    "ffi",
    "cross-platform"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "koffi": "2.16.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitest": "3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imxade/inject.git"
  },
  "homepage": "https://github.com/imxade/inject#readme",
  "bugs": {
    "url": "https://github.com/imxade/inject/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
