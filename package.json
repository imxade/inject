{
  "name": "@imxade/inject",
  "version": "0.0.1",
  "description": "Low-level cross-platform native input injection primitives for Node.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./linux": {
      "types": "./dist/linux/index.d.ts",
      "import": "./dist/linux/index.js"
    },
    "./mac": {
      "types": "./dist/mac/index.d.ts",
      "import": "./dist/mac/index.js"
    },
    "./windows": {
      "types": "./dist/windows/index.d.ts",
      "import": "./dist/windows/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "biome check src test vitest.config.ts",
    "check:fix": "biome check --write src test vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "input",
    "native",
    "uinput",
    "coregraphics",
    "sendinput",
    "vigem",
    "ffi",
    "cross-platform"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "koffi": "2.16.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.10.2",
    "typescript": "7.0.2",
    "vitest": "3.0.5"
  }
}
